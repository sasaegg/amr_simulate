<!--
  建圖：slam_toolbox 非同步線上建圖。依 /ID/scan、/ID/odom 與 TF 建 2D 佔據格地圖，
  發布 /ID/map 與 TF map → ID/odom。只用車輛標準介面，模擬與真車相同。

  用法（robot 容器內，車子系統已在執行）：
    ros2 launch amr_navigation mapping.launch.xml use_sim_time:=true
  通常用 amr_rviz_plugins/mapping_ui.launch.xml（建圖 + RViz 建圖面板）一起開

  存圖：RViz 建圖面板的「存圖」按鈕（呼叫 /ID/map_saver/save_map），或 map_saver_cli 指令（見 README）
-->
<launch>
  <arg name="robot_id" default="amr1" description="車輛 id（namespace 與 frame 前綴）"/>
  <arg name="use_sim_time" default="false" description="模擬時為 true（由中控帶起時自動設定）"/>

  <let name="params" value="$(find-pkg-share amr_navigation)/config/mapping.yaml"/>

  <!-- use_sim_time 用 ros_args 傳：套用到程序內所有節點（navigation.launch.xml 同樣做法） -->
  <group>
    <push-ros-namespace namespace="$(var robot_id)"/>

    <!-- async：跟不上時跳過部分 scan，不累積延遲；官方建議線上建圖用這個 -->
    <node pkg="slam_toolbox" exec="async_slam_toolbox_node" name="slam_toolbox" ros_args="-p use_sim_time:=$(var use_sim_time)" output="screen">
      <param from="$(var params)" allow_substs="true"/>
    </node>

    <!-- 存圖服務 /ID/map_saver/save_map（nav2_msgs/SaveMap）：RViz 建圖面板的「存圖」按鈕呼叫它 -->
    <node pkg="nav2_map_server" exec="map_saver_server" name="map_saver" ros_args="-p use_sim_time:=$(var use_sim_time)" output="screen">
      <param from="$(var params)" allow_substs="true"/>
    </node>

    <!-- map_saver 是 lifecycle node，要有 lifecycle_manager 帶起 -->
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_mapping" ros_args="-p use_sim_time:=$(var use_sim_time)" output="screen">
      <param from="$(var params)" allow_substs="true"/>
    </node>
  </group>
</launch>
