<?xml version="1.0"?>
<!-- 差速驅動 AMR：兩個驅動輪 + 前後剛性支撐球。
     link／joint 名稱不帶前綴；ROS 的 TF 前綴（amr1/）由 robot_state_publisher 的 frame_prefix 加上。
     robot_id 給 Gazebo 外掛填 frame 與 topic 用（task 4.2）。 -->
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="robot_id" default="amr1"/>
  <xacro:property name="robot_id" value="$(arg robot_id)"/>

  <!-- ===== 尺寸（公尺、公斤） ===== -->
  <xacro:property name="chassis_length" value="0.5"/>
  <xacro:property name="chassis_width" value="0.4"/>
  <xacro:property name="chassis_height" value="0.2"/>
  <xacro:property name="chassis_clearance" value="0.03"/>
  <xacro:property name="chassis_mass" value="15.0"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="wheel_y" value="${chassis_width / 2 + wheel_width / 2}"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_mass" value="0.1"/>
  <xacro:property name="caster_x" value="0.2"/>

  <xacro:property name="laser_radius" value="0.04"/>
  <xacro:property name="laser_height" value="0.05"/>
  <xacro:property name="laser_mass" value="0.2"/>
  <xacro:property name="laser_x" value="0.15"/>

  <!-- ===== 運動限制（spec：1.0 m/s、1.5 rad/s；加速度讓停車在 watchdog 0.5 s 後 0.4 s 內完成） ===== -->
  <xacro:property name="max_linear_velocity" value="1.0"/>
  <xacro:property name="max_angular_velocity" value="1.5"/>
  <xacro:property name="max_linear_acceleration" value="2.5"/>
  <xacro:property name="max_angular_acceleration" value="5.0"/>

  <!-- ===== 感測器 ===== -->
  <xacro:property name="odom_rate" value="30"/>
  <xacro:property name="lidar_rate" value="10"/>
  <xacro:property name="lidar_samples" value="360"/>
  <xacro:property name="lidar_min_range" value="0.12"/>
  <xacro:property name="lidar_max_range" value="12.0"/>
  <xacro:property name="imu_rate" value="100"/>

  <!-- base_link 原點在輪軸高度；以下高度都相對於 base_link -->
  <xacro:property name="chassis_z" value="${chassis_clearance + chassis_height / 2 - wheel_radius}"/>
  <xacro:property name="chassis_top_z" value="${chassis_clearance + chassis_height - wheel_radius}"/>
  <xacro:property name="caster_z" value="${caster_radius - wheel_radius}"/>
  <xacro:property name="laser_z" value="${chassis_top_z + laser_height / 2}"/>

  <!-- ===== 慣性巨集（均質實心物體，相對於質心） ===== -->
  <!-- com_z：質心相對 link 原點的高度（預設 0 = 質心就在 link 原點） -->
  <xacro:macro name="box_inertial" params="m x y z com_z:=0">
    <inertial>
      <origin xyz="0 0 ${com_z}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m / 12 * (y * y + z * z)}" ixy="0" ixz="0"
               iyy="${m / 12 * (x * x + z * z)}" iyz="0"
               izz="${m / 12 * (x * x + y * y)}"/>
    </inertial>
  </xacro:macro>

  <!-- 圓柱的軸沿 z；輪子會再整個轉到 y 軸，所以 ixx = izz、iyy 為繞軸慣量 -->
  <xacro:macro name="wheel_inertial" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m / 12 * (3 * r * r + h * h)}" ixy="0" ixz="0"
               iyy="${m / 2 * r * r}" iyz="0"
               izz="${m / 12 * (3 * r * r + h * h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m / 12 * (3 * r * r + h * h)}" ixy="0" ixz="0"
               iyy="${m / 12 * (3 * r * r + h * h)}" iyz="0"
               izz="${m / 2 * r * r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2 / 5 * m * r * r}" ixy="0" ixz="0"
               iyy="${2 / 5 * m * r * r}" iyz="0"
               izz="${2 / 5 * m * r * r}"/>
    </inertial>
  </xacro:macro>

  <!-- ===== base_footprint：地面上、車子中心的投影（REP-105） =====
       沒有 inertial：KDL（robot_state_publisher 用的運動學函式庫）不接受有慣量的根 link -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===== 車身 ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_gray"><color rgba="0.3 0.3 0.35 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertial m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"
                        com_z="${chassis_z}"/>
  </link>

  <!-- ===== 驅動輪（左 side=1、右 side=-1） ===== -->
  <xacro:macro name="drive_wheel" params="name side">
    <link name="${name}_wheel_link">
      <!-- 圓柱預設軸沿 z，繞 x 轉 90° 讓軸改沿 y -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <!-- 碰撞用球：圓柱與地面的接觸點會落在輪緣，有效輪距變成內緣距離 0.40 m（參數 0.44），
           實測原地旋轉多轉約 10%、odom 漂移，SLAM 建出的地圖扭曲。球只有一個接觸點且在輪子中心平面上 -->
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <xacro:wheel_inertial m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="0 ${side * wheel_y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel name="left" side="1"/>
  <xacro:drive_wheel name="right" side="-1"/>

  <!-- ===== 支撐球（前 side=1、後 side=-1）：固定在車身、零摩擦，只負責撐住車身 ===== -->
  <xacro:macro name="caster" params="name side">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="caster_silver"><color rgba="0.7 0.7 0.7 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertial m="${caster_mass}" r="${caster_radius}"/>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${side * caster_x} 0 ${caster_z}" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo 擴充：摩擦係數 0，球在地上滑動而不卡住轉向 -->
    <gazebo reference="${name}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" side="1"/>
  <xacro:caster name="rear" side="-1"/>

  <!-- ===== 光達：車頂上方 ===== -->
  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="${laser_radius}" length="${laser_height}"/></geometry>
      <material name="laser_red"><color rgba="0.8 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="${laser_radius}" length="${laser_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertial m="${laser_mass}" r="${laser_radius}" h="${laser_height}"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${laser_x} 0 ${laser_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===== IMU：與 base_link 同位置，沒有外形 ===== -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================
       Gazebo（Fortress）外掛與感測器
       Gazebo 這一側不經過 robot_state_publisher，frame 與 topic 要自己帶 robot_id 前綴
       =================================================================== -->

  <gazebo>
    <!-- 差速驅動：收 cmd_vel → 轉動兩輪；由輪子轉動計算並發布里程計與 odom→base_footprint TF -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2 * wheel_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <!-- 速度指令來自 watchdog（task 5.2），不是直接來自 /cmd_vel -->
      <topic>/${robot_id}/cmd_vel_gz</topic>
      <odom_topic>/${robot_id}/odom</odom_topic>
      <tf_topic>/${robot_id}/tf</tf_topic>
      <frame_id>${robot_id}/odom</frame_id>
      <child_frame_id>${robot_id}/base_footprint</child_frame_id>
      <odom_publish_frequency>${odom_rate}</odom_publish_frequency>
      <min_linear_velocity>${-max_linear_velocity}</min_linear_velocity>
      <max_linear_velocity>${max_linear_velocity}</max_linear_velocity>
      <min_angular_velocity>${-max_angular_velocity}</min_angular_velocity>
      <max_angular_velocity>${max_angular_velocity}</max_angular_velocity>
      <min_linear_acceleration>${-max_linear_acceleration}</min_linear_acceleration>
      <max_linear_acceleration>${max_linear_acceleration}</max_linear_acceleration>
      <min_angular_acceleration>${-max_angular_acceleration}</min_angular_acceleration>
      <max_angular_acceleration>${max_angular_acceleration}</max_angular_acceleration>
    </plugin>

    <!-- 發布輪子 joint 的角度；robot_state_publisher 用它算出輪子的 TF -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/${robot_id}/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- 2D 光達：gpu_lidar 以 GPU 渲染深度影像換算距離（需要 world 載入 Sensors 系統、ogre2） -->
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/${robot_id}/scan</topic>
      <update_rate>${lidar_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <!-- fixed joint 在轉成 SDF 時會被併入根 link base_footprint，laser_link 不再存在，必須明確指定訊息的 frame -->
      <ignition_frame_id>${robot_id}/laser_link</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <!-- 不含 +π：避免 -π 與 +π 兩個樣本落在同一方向，角度間隔剛好 1° -->
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2 * pi / lidar_samples}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${lidar_min_range}</min>
          <max>${lidar_max_range}</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- IMU：需要 world 載入 Imu 系統 -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/${robot_id}/imu</topic>
      <update_rate>${imu_rate}</update_rate>
      <always_on>true</always_on>
      <ignition_frame_id>${robot_id}/imu_link</ignition_frame_id>
    </sensor>
  </gazebo>

</robot>
