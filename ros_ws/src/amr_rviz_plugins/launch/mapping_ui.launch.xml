<!--
  建圖 UI：建圖（amr_navigation/mapping.launch.xml）＋ RViz（config/mapping.rviz：地圖、光達、車身與「AMR 建圖」面板）。
  在面板輸入地圖名稱、按「存圖」即存到 /data/maps/NAME。

  用法（robot 容器內，車子系統已在執行）：
    ros2 launch amr_rviz_plugins mapping_ui.launch.xml use_sim_time:=true
  放在操作員工具套件（而不是 amr_navigation）：RViz 是操作員用的，車上的系統不需要它。
-->
<launch>
  <arg name="robot_id" default="amr1" description="車輛 id"/>
  <arg name="use_sim_time" default="false" description="模擬時為 true"/>

  <include file="$(find-pkg-share amr_navigation)/launch/mapping.launch.xml">
    <arg name="robot_id" value="$(var robot_id)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <!-- RViz 關掉時整個建圖 UI 一起結束 -->
  <node pkg="rviz2" exec="rviz2" name="rviz_mapping" output="screen" on_exit="shutdown"
        args="-d $(find-pkg-share amr_rviz_plugins)/config/mapping.rviz"
        ros_args="-p use_sim_time:=$(var use_sim_time)"/>
</launch>
